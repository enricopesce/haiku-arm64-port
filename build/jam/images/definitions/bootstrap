# This file defines the content of the bootstrap Haiku image.

# import everything from the minimum image
include [ FDirName $(HAIKU_BUILD_RULES_DIR) images definitions minimum ] ;

# A bootstrap image is a self-contained native ARM64 development environment.
# Add every locally built HaikuPortsCross package explicitly.  Resolving only
# package-family names through AddHaikuImageSystemPackages is insufficient here:
# bootstrap package names are normalized (e.g. git_bootstrap -> git), which can
# leave a successfully built HPKG out of the image.
local bootstrapRepository = <repository>HaikuPortsCross ;
local bootstrapPackage ;
for bootstrapPackage
		in [ on $(bootstrapRepository) return $(HAIKU_REPOSITORY_PACKAGES) ] {
	local packageArchitecture
		= [ on $(bootstrapPackage) return $(HAIKU_PACKAGE_ARCHITECTURE) ] ;
	if $(packageArchitecture) != source {
		local packageFileName
			= [ on $(bootstrapPackage) return $(HAIKU_PACKAGE_FILE_NAME) ] ;
		# The base image already supplies these packages from the current
		# Haiku build. Adding bootstrap copies would shadow that coherent
		# system set and can change the desktop/service startup behavior.
		local packageBaseName = $(packageFileName:G=) ;
		local coreHaikuPackage
			= [ Match "^haiku(_loader|_devel|_datatranslators)?-"
				: $(packageBaseName) ] ;
		if ! $(coreHaikuPackage) {
			# Keep development packages out of /boot/system/packages: the
			# minimum image remains the authoritative desktop and service base.
			AddPackageFilesToHaikuImage home config packages
				: <cross-built>$(packageFileName)
				: nameFromMetaInfo ;
		}
	}
}

# Add the HaikuPorts configuration. Source packages are deliberately supplied
# on the separate VirtIO CD: copying them into the root image triggers an
# ARM64 kernel panic during early package processing.
#
# The port tree itself contains recipes and patches, not active HPKGs. Keeping
# it on the writable boot volume lets the guest build missing and future ARM64
# packages natively with HaikuPorter.
CopyDirectoryToHaikuImage home
	: $(HAIKU_PORTS)
	: haikuports : -x .git -x work-* -x packages ;

AddFilesToHaikuImage home haikuports
	: [ BuildHaikuPortsRepositoryConfig /boot/home/haikuports ] ;

# copy the haikuports format versions file
local formatVersionsFile = <haikuports>FormatVersions ;
SEARCH on $(formatVersionsFile) = $(HAIKU_PORTS) ;
AddFilesToHaikuImage home haikuports : $(formatVersionsFile) ;

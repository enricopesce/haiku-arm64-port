# This profile is a clean minimum desktop with a non-active local package
# payload. Packages are copied to /boot/home/Packages and are installed by the
# user through pkgman after boot; packagefs sees only the minimum image until
# then.

include [ FDirName $(HAIKU_BUILD_RULES_DIR) images definitions minimum ] ;

if ! $(HAIKU_DEVELOPMENT_PACKAGE_PAYLOAD_DIR) {
	Exit "development image requires HAIKU_DEVELOPMENT_PACKAGE_PAYLOAD_DIR" ;
}

CopyDirectoryToHaikuImage home
	: $(HAIKU_DEVELOPMENT_PACKAGE_PAYLOAD_DIR) : Packages ;

#!/bin/sh
# Create a non-active package payload for the clean ARM64 development image.
# Packages live in /boot/home/Packages until the user chooses to install them
# with pkgman from inside Haiku.

set -eu

if [ "$#" -ne 2 ]; then
	echo "usage: $0 <package-directory> <destination>" >&2
	exit 2
fi

package_directory=$1
destination=$2
temporary_directory="${destination}.tmp"

rm -rf "$temporary_directory"
mkdir -p "$temporary_directory"

for package_file in "$package_directory"/*.hpkg; do
	package_name=${package_file##*/}
	case "$package_name" in
		*-source.hpkg|libtool_cross_generic-*|noto-20170202-7-any.hpkg|\
		curl_bootstrap-8.19.0-1-arm64.hpkg|\
		curl_bootstrap_devel-8.19.0-1-arm64.hpkg|\
		git_bootstrap-2.54.0-1-arm64.hpkg)
			continue
			;;
	esac
	ln "$package_file" "$temporary_directory/$package_name"
done

rm -rf "$destination"
mv "$temporary_directory" "$destination"

#!/bin/sh
# Run HaikuPorter for a target architecture without inheriting macOS package
# discovery paths.  Cross recipes must only observe their Haiku sysroot.
set -eu

emptyPkgConfigDir=${HAIKU_CROSS_EMPTY_PKGCONFIG_DIR:-/private/tmp/haiku-cross-empty-pkgconfig}
mkdir -p "$emptyPkgConfigDir"

# This bootstrap repository is ARM64-only.  HaikuPorter adds the cross tools
# to PATH for most build systems, but plain Makefiles commonly invoke `cc`,
# `ar`, or `ranlib` directly and would otherwise select the macOS tools.
# Export the complete target toolchain once here, before HaikuPorter starts.
crossTools=${HAIKU_CROSS_TOOLS:-/Volumes/HaikuCase/haiku/generated.arm64/cross-tools-arm64}
targetTriple=${HAIKU_CROSS_TRIPLE:-aarch64-unknown-haiku}
export PATH="$crossTools/bin:$PATH"
export CC="$targetTriple-gcc"
export CXX="$targetTriple-g++"
export AR="$targetTriple-ar"
export AS="$targetTriple-as"
export LD="$targetTriple-ld"
export NM="$targetTriple-nm"
export RANLIB="$targetTriple-ranlib"
export STRIP="$targetTriple-strip"

unset ACLOCAL_PATH \
	CFLAGS CXXFLAGS CPPFLAGS LDFLAGS \
	CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH OBJC_INCLUDE_PATH \
	LIBRARY_PATH DYLD_FALLBACK_LIBRARY_PATH \
	SDKROOT MACOSX_DEPLOYMENT_TARGET \
	PKG_CONFIG_PATH PKG_CONFIG_SYSROOT_DIR

# Homebrew's pkg-config default directories are otherwise searched even when
# a recipe has no target package supplying the requested module.
export PKG_CONFIG_LIBDIR="$emptyPkgConfigDir"

exec "$@"

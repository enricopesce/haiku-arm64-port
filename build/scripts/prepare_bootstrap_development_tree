#!/bin/sh
# Build a user-level non-packaged development tree from the ARM64 bootstrap
# repository.  Keeping these files out of */packages is intentional: packagefs
# must see exactly the minimum-image package set during desktop startup.

set -eu

if [ "$#" -ne 3 ]; then
	echo "usage: $0 <package-tool> <package-directory> <destination>" >&2
	exit 2
fi

package_tool=$1
package_directory=$2
destination=$3
temporary_directory="${destination}.tmp"

rm -rf "$temporary_directory"
mkdir -p "$temporary_directory" "$destination"

for package_file in "$package_directory"/*.hpkg; do
	package_name=${package_file##*/}
	case "$package_name" in
		*-source.hpkg|haiku-*.hpkg|haiku_loader-*.hpkg|haiku_devel-*.hpkg|\
		haiku_datatranslators-*.hpkg|haiku_cross_*.hpkg)
			continue
			;;
	esac

	rm -rf "$temporary_directory"/*
	"$package_tool" extract -C "$temporary_directory" "$package_file"
	# Later revisions sort after earlier ones and deliberately replace them.
	rsync -a "$temporary_directory"/ "$destination"/
done

rm -rf "$temporary_directory"

set -eu

if [ "$#" -ne 1 ]; then
	echo "usage: $0 <haiku-mmc.image>" >&2
	exit 2
fi

image=$1
qemu=${QEMU_SYSTEM_AARCH64:-qemu-system-aarch64}
firmware=${QEMU_AARCH64_FIRMWARE:-}
seconds=${QEMU_SMOKE_SECONDS:-25}
cpus=${QEMU_SMOKE_CPUS:-4}
tcpdump=${TCPDUMP:-tcpdump}

if [ -z "$firmware" ]; then
	echo "QEMU_AARCH64_FIRMWARE must name the EDK2 AArch64 firmware" >&2
	exit 2
fi

if ! command -v "$tcpdump" >/dev/null 2>&1; then
	echo "TCPDUMP must name a tcpdump executable" >&2
	exit 2
fi

case "$cpus" in
	1|2|3|4) ;;
	*)
		echo "QEMU_SMOKE_CPUS must be between 1 and 4" >&2
		exit 2
		;;
esac

log=$(mktemp -t haiku-arm64-qemu-smoke.XXXXXX)
capture=$(mktemp -t haiku-arm64-qemu-network.XXXXXX)
pid=

cleanup()
{
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		kill "$pid" 2>/dev/null || true
		wait "$pid" 2>/dev/null || true
	fi
	rm -f "$log" "$capture"
}
trap cleanup EXIT HUP INT TERM

"$qemu" \
	-machine virt,accel=hvf,acpi=off,gic-version=2 -cpu host -smp "$cpus" -m 2048 \
	-bios "$firmware" \
	-drive if=none,file="$image",format=raw,id=drive0 \
	-device virtio-blk-pci,drive=drive0,disable-legacy=on,vectors=0 \
	-device ramfb \
	-netdev user,id=net0 \
	-object "filter-dump,id=netdump,netdev=net0,file=$capture" \
	-device virtio-net-pci,netdev=net0,disable-legacy=on,vectors=0 \
	-display none -serial "file:$log" -monitor none -snapshot &
pid=$!

sleep "$seconds"
kill "$pid" 2>/dev/null || true
wait "$pid" 2>/dev/null || true
pid=

for marker in \
	'kind: gicv2' \
	"scheduler_init: found $cpus logical cpu" \
	'Mounted boot partition: /dev/disk/virtual/virtio_block/0/1' \
	'Volume::InitialVerify(): volume at "/boot/system" is consistent'; do
	if ! LC_ALL=C grep -aF "$marker" "$log" >/dev/null; then
		echo "missing boot marker: $marker" >&2
		LC_ALL=C tail -100 "$log" >&2 || true
		exit 1
	fi
done

dhcp=$("$tcpdump" -nn -vv -r "$capture" 'udp port 67 or udp port 68' 2>/dev/null)
for state in Discover Offer Request ACK; do
	if ! printf '%s\n' "$dhcp" | grep -F 'DHCP-Message' | grep -F ": $state" >/dev/null; then
		echo "missing DHCP state: $state" >&2
		printf '%s\n' "$dhcp" >&2
		exit 1
	fi
done

if ! printf '%s\n' "$dhcp" | grep -F 'Your-IP 10.0.2.15' >/dev/null; then
	echo "missing QEMU DHCP lease for 10.0.2.15" >&2
	printf '%s\n' "$dhcp" >&2
	exit 1
fi

echo "ARM64 QEMU smoke test passed"

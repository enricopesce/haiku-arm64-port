SubDir HAIKU_TOP src bin debug ltrace ;

UsePrivateHeaders debug ;
UsePrivateHeaders runtime_loader ;
UsePrivateHeaders shared ;
UsePrivateSystemHeaders ;

Application ltrace
	:
	ltrace.cpp
;

# ARM64 has no ltrace architecture stub yet.  The ltrace client itself remains
# useful, but omit the unavailable stub library until an ARM64 backend exists.
if $(TARGET_ARCH) != arm64 {
	SharedLibrary libltrace_stub.so
		:
		ltrace_stub.cpp
		:
		arch_ltrace_stub.a
	;

	HaikuSubInclude arch $(TARGET_ARCH) ;
}
